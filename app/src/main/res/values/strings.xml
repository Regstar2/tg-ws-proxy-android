    <string name="main_hint_bydpi">If ByeDPI or another local proxy is used at the same time, set TgWsProxy to port 1081 to avoid a port conflict with common defaults.</string>
    <string name="main_hint_background">For stable background operation, disable battery restrictions for TgWsProxy and pin the app in memory if the device firmware aggressively stops services.</string>
