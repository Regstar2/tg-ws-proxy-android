    <string name="tips_section_cf_custom">Custom Cloudflare domains</string>
    <string name="tips_cf_custom">For regular use add your domain in Cloudflare (Flexible SSL) and create kws* A records per Flowseal instructions. Enter only the domain in TgWsProxy, without https:// or path.</string>
    <string name="tips_section_troubleshooting">Common issues</string>
    <string name="tips_troubleshooting">Telegram not connecting: check 127.0.0.1, port, proxy running, try Auto or CF only.\nWorker fails: use hostname only, publish Worker.\nCF domains fail: update list, check cooldown, try your own domain.\nMedia fails: try CF only, check DC/IP settings.</string>
